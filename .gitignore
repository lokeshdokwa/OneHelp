# ==========================================
# OneHelp Monorepo .gitignore
# Multi-stack: React Native/Expo, Backend, DB, Connectivity
# ==========================================

# --- Node / npm / yarn ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json.bak

# --- Expo & React Native ---
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# --- Native Build Artifacts ---
.kotlin/
.gradle/
build/
android/app/build/
ios/build/
ios/Pods/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# --- Python (Backend) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- AI / ML Model Weights & Checkpoints ---
*.h5
*.ckpt
*.pt
*.pth
*.pkl

# --- Database & Local Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# --- TypeScript ---
*.tsbuildinfo

# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example
*.pem
*.cert
*.crt
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# --- Logs & Runtime ---
logs/
*.log
*.tmp
*.temp
build-error.txt

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDEs & Editors ---
.vscode/
.idea/
.claude/
*.sublime-project
*.sublime-workspace
*.swp
*.swp
*~
