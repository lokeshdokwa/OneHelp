generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices           Device[]
  contacts          TrustedContact[]
  incidents         SosIncident[]
  pushTokens        DevicePushToken[]
  chatMessages      ChatMessage[]
  ownedCircles      SafetyCircle[]       @relation("CircleOwner")
  circleMemberships SafetyCircleMember[]
  medicalProfile    MedicalProfile?
  feedbacks         Feedback[]
}

model Device {
  id          String   @id @default(uuid())
  deviceId    String   @unique
  platform    String
  appVersion  String?
  deviceLabel String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TrustedContact {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  name         String
  phone        String
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, phone])
}

model SosIncident {
  id           String    @id // Provided by client (sosId) for idempotency
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  status       String // ACTIVE, DISPATCHING, DISPATCHED, RESPONDER_ASSIGNED, EN_ROUTE, ON_SCENE, RESOLVED, CANCELLED
  triggerType  String
  isSilent     Boolean   @default(false)
  isDuress     Boolean   @default(false)
  messageText  String?
  batteryLevel Int?
  priority     Int       @default(1) // Higher means more critical
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?

  locations   SosLocation[]
  events      SosEvent[]
  assignments ResponderAssignment[]
  evidence    Evidence[]
  feedbacks   Feedback[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SosLocation {
  id         String      @id @default(uuid())
  incidentId String
  incident   SosIncident @relation(fields: [incidentId], references: [id])
  latitude   Float
  longitude  Float
  accuracy   Float?
  altitude   Float?
  address    String?
  timestamp  DateTime

  @@index([incidentId])
  @@index([timestamp])
  @@index([latitude, longitude])
}

model SosEvent {
  id         String      @id @default(uuid())
  incidentId String
  incident   SosIncident @relation(fields: [incidentId], references: [id])
  eventType  String // SOS_CREATED, DISPATCH_STARTED, RESPONDER_ASSIGNED, DURESS_TRIGGERED, SOS_CANCELLED, etc.
  details    String?
  timestamp  DateTime    @default(now())

  @@index([incidentId])
}

model Responder {
  id          String                @id @default(uuid())
  name        String
  callSign    String                @unique
  role        String // PARAMEDIC, POLICE_OFFICER, FIRE_RESCUE, DISASTER_UNIT
  phone       String?
  status      String // AVAILABLE, DISPATCHED, EN_ROUTE, ON_SCENE, OFFLINE
  latitude    Float?
  longitude   Float?
  updatedAt   DateTime              @updatedAt
  assignments ResponderAssignment[]

  @@index([status])
  @@index([latitude, longitude])
}

model ResponderAssignment {
  id          String      @id @default(uuid())
  incidentId  String
  incident    SosIncident @relation(fields: [incidentId], references: [id])
  responderId String
  responder   Responder   @relation(fields: [responderId], references: [id])
  status      String // ASSIGNED, EN_ROUTE, ON_SCENE, COMPLETED, CANCELLED
  assignedAt  DateTime    @default(now())
  acceptedAt  DateTime?
  completedAt DateTime?

  @@unique([incidentId, responderId])
}

model Hazard {
  id           String   @id // Client provided (idempotency)
  type         String // FLOOD, FIRE, ROAD_BLOCK, LANDSLIDE, GAS_LEAK, BUILDING_COLLAPSE, OTHER
  title        String
  description  String
  latitude     Float
  longitude    Float
  radiusMeters Float
  severity     String // LOW, MEDIUM, HIGH, CRITICAL
  status       String // PENDING_REVIEW, VERIFIED, REJECTED, RESOLVED
  photoUri     String?
  reportedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([latitude, longitude])
}

model GreenCorridorRequest {
  id                  String   @id // Client provided
  ambulancePlate      String
  patientCondition    String
  originHospital      String
  destinationHospital String
  currentLat          Float
  currentLng          Float
  destLat             Float
  destLng             Float
  etaMinutes          Float
  routeSummary        String
  status              String // REQUESTED, ACTIVE, CLEARED, COMPLETED, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DevicePushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String
  platform  String
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, token])
}

model Evidence {
  id              String       @id @default(uuid())
  incidentId      String?
  incident        SosIncident? @relation(fields: [incidentId], references: [id])
  fileType        String
  sizeBytes       Int
  durationSeconds Int?
  storageKey      String
  checksum        String?
  createdAt       DateTime     @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      String?
  action     String
  resource   String
  resourceId String?
  requestId  String?
  details    String?
  timestamp  DateTime @default(now())

  @@index([action])
  @@index([resource, resourceId])
}

model ChatMessage {
  id                 String   @id
  senderId           String
  sender             User     @relation(fields: [senderId], references: [id])
  senderName         String
  recipientContactId String?
  messageText        String
  status             String
  isEmergencyAlert   Boolean  @default(false)
  timestamp          DateTime
  createdAt          DateTime @default(now())
}

model SafetyCircle {
  id        String               @id @default(uuid())
  name      String
  ownerId   String
  owner     User                 @relation("CircleOwner", fields: [ownerId], references: [id])
  members   SafetyCircleMember[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model SafetyCircleMember {
  id        String       @id @default(uuid())
  circleId  String
  circle    SafetyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  role      String // OWNER, ADMIN, MEMBER
  createdAt DateTime     @default(now())

  @@unique([circleId, userId])
}

model MedicalProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodGroup     String?
  allergies      String?
  conditions     String?
  medications    String?
  emergencyNotes String?
  updatedAt      DateTime @updatedAt
}

model Feedback {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  incidentId String
  incident   SosIncident @relation(fields: [incidentId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime    @default(now())

  @@unique([userId, incidentId])
}
