NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database — NEVER commit a real password. Use your actual PostgreSQL password here.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/onehelp?schema=public"

# Auth — Change this to a strong random secret in production
JWT_SECRET=supersecretjwtkey_change_me_in_production
JWT_EXPIRES_IN=30d

# Security
CORS_ORIGINS=http://localhost:8081,exp://localhost:8081

# External Providers (Set DEMO_MODE=false to require these)
DEMO_MODE=true

# Real provider secrets (left blank for local dev, do NOT fill in and commit)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
STORAGE_PROVIDER=
STORAGE_BUCKET=
EMERGENCY_DISPATCH_PROVIDER=
TRAFFIC_SIGNAL_PROVIDER=
